<apex:page controller="FcEngineController" showHeader="false" sidebar="false" standardStylesheets="false"
           applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false">
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>FileCrate engine</title>
</head>
<body>
<!--
  FileCrate engine. Runs inside an iframe owned by the fcCrateBuilder LWC.
  It fetches file bytes from the REST API with this page's session, zips them
  in the browser and hands each finished zip to the parent as a Blob.
  It only accepts messages from, and only replies to, this org's Lightning origin.
-->
<script src="{!URLFOR($Resource.fflate, 'index.js')}"></script>
<script src="{!$Resource.fcEngineBundle}"></script>
<script>
(function () {
    'use strict';
    var parentOrigin = '{!JSENCODE(lightningOrigin)}';
    if (window.parent === window) {
        return;
    }
    var engine = window.FcEngine.createEngine({
        fflate: window.fflate,
        core: window.FcCore,
        fetchFn: function (url, init) { return window.fetch(url, init); },
        post: function (message) { window.parent.postMessage(message, parentOrigin); },
        apiBase: '/services/data/v{!JSENCODE(apiVersion)}/',
        sessionId: '{!JSENCODE($Api.Session_ID)}',
        baseUrl: '{!JSENCODE(baseUrl)}'
    });
    window.addEventListener('message', function (event) {
        if (event.origin !== parentOrigin || event.source !== window.parent) {
            return;
        }
        engine.handle(event.data);
    });
    window.parent.postMessage({ fc: 1, type: 'ready' }, parentOrigin);
})();
</script>
</body>
</html>
</apex:page>
